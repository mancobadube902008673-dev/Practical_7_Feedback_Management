@model Feedback
<div class="form-card">
    <h2>Share your experience</h2>
    <p class="muted">Fields marked with * are required.</p>
    <form asp-controller="Feedback" asp-action="Index" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <div class="form-group">
            <label asp-for="Name"></label><span class="required"> *</span>
            @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Enter your full name" })
            <span asp-validation-for="Name" class="field-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="Email"></label><span class="required"> *</span>
            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "name@example.com" })
            <span asp-validation-for="Email" class="field-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="Rating"></label><span class="required"> *</span>
            @Html.DropDownListFor(m => m.Rating,
                new SelectList(new[] {
                    new { Value = "5", Text = "5 - Excellent" },
                    new { Value = "4", Text = "4 - Very Good" },
                    new { Value = "3", Text = "3 - Good" },
                    new { Value = "2", Text = "2 - Fair" },
                    new { Value = "1", Text = "1 - Poor" }
                }, "Value", "Text"), "-- Select a rating --", new { @class = "form-control" })
            <span asp-validation-for="Rating" class="field-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="Comments"></label><span class="required"> *</span>
            @Html.TextAreaFor(m => m.Comments, 4, 50, new { @class = "form-control", placeholder = "Tell us what went well or what we can improve..." })
            <span asp-validation-for="Comments" class="field-error"></span>
        </div>
        <button type="submit" class="btn-primary">Submit Feedback</button>
    </form>
</div>