<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Feedback Management</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="site-header"><div class="container nav">
    <a class="brand" asp-controller="Feedback" asp-action="Index">Feedback Portal</a>
    <span class="nav-note">We value your opinion</span>
</div></header>
<main class="container main-content">@RenderBody()</main>
<footer class="site-footer"><div class="container">Feedback Management Module · ASP.NET Core MVC</div></footer>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>